{
  "name": "@ariadocs/components",
  "version": "0.1.0",
  "type": "module",
  "author": {
    "name": "Nisab Mohd",
    "email": "nisabmohd@gmail.com"
  },
  "license": "MIT",
  "description": "shadcn-style compound components for Ariadocs. Renders the models produced by @ariadocs/react and @ariadocs/openapi through composable OpenAPI.* and Docs.* component trees.",
  "keywords": [
    "react",
    "shadcn",
    "openapi",
    "documentation",
    "docs",
    "components",
    "ariadocs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/openapi.css": {
      "default": "./dist/styles/openapi.css"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsc && copyfiles -u 1 \"src/styles/**/*.css\" dist",
    "check-types": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.4.1",
  "dependencies": {
    "@ariadocs/openapi": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "copyfiles": "^2.4.1",
    "eslint": "^9.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nisabmohd/Aria-Docs.git",
    "directory": "packages/lib-components"
  },
  "bugs": {
    "url": "https://github.com/nisabmohd/Aria-Docs/issues"
  },
  "homepage": "https://github.com/nisabmohd/Aria-Docs#readme"
}
